{
  "name": "vscode-stealth-chat",
  "displayName": "TS-Lint Service",
  "description": "A stealth chat client disguised as a linting service",
  "version": "1.0.0",
  "publisher": "stealth",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sisyphean-a/vscode-stealth-chat.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tsLintService",
          "title": "TS-Lint Service",
          "icon": "$(check)"
        }
      ]
    },
    "views": {
      "tsLintService": [
        {
          "type": "webview",
          "id": "tsLintChat.chatView",
          "name": "Service Monitor"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.stealthSend",
        "title": "Configure Parameters",
        "category": "TS-Lint"
      },
      {
        "command": "tsLintService.focus",
        "title": "Focus Service Monitor",
        "category": "TS-Lint"
      },
      {
        "command": "tsLintService.switchConnection",
        "title": "Switch Rule Set",
        "category": "TS-Lint"
      }
    ],
    "configuration": {
      "title": "TS-Lint Service",
      "properties": {
        "tsLint.serverUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Server URL for the TS-Lint service"
        },
        "tsLint.secret": {
          "type": "string",
          "default": "ChangeMeInProduction",
          "description": "Secret token for secure connection"
        },
        "tsLint.forceWebsocket": {
          "type": "boolean",
          "default": false,
          "description": "Force WebSocket transport (recommended for Cloudflare Tunnels)"
        },
        "tsLint.autoReveal": {
          "type": "boolean",
          "default": false,
          "description": "Automatically reveal output channel and mark as read when new message arrives"
        },
        "tsLint.displayMode": {
          "type": "string",
          "enum": ["bubble", "log"],
          "default": "bubble",
          "description": "Output format for service messages (bubble: standard, log: compact log format)"
        },
        "tsLint.connections": {
          "type": "array",
          "default": [],
          "description": "Rule set configurations",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "Rule set name" },
              "serverUrl": { "type": "string", "description": "Server URL" },
              "token": { "type": "string", "description": "Authentication token" }
            },
            "required": ["name", "token"]
          }
        },
        "tsLint.activeConnection": {
          "type": "string",
          "default": "",
          "description": "Active rule set name"
        }
      }
    },
    "keybindings": [
      {
        "command": "extension.stealthSend",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "socket.io-client": "^4.7.0"
  }
}
