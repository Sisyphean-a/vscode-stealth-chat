{
  "name": "vscode-stealth-chat",
  "displayName": "TS-Lint Service",
  "description": "A stealth chat client disguised as a linting service",
  "version": "1.0.0",
  "publisher": "stealth",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sisyphean-a/vscode-stealth-chat.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tsLintService",
          "title": "TS-Lint Service",
          "icon": "$(check)"
        }
      ]
    },
    "views": {
      "tsLintService": [
        {
          "type": "webview",
          "id": "tsLintChat.chatView",
          "name": "Service Monitor"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.stealthSend",
        "title": "Configure Parameters",
        "category": "TS-Lint"
      },
      {
        "command": "tsLintService.focus",
        "title": "Focus Service Monitor",
        "category": "TS-Lint"
      },
      {
        "command": "tsLintService.switchConnection",
        "title": "Switch Connection",
        "category": "TS-Lint"
      }
    ],
    "configuration": {
      "title": "TS-Lint Service",
      "properties": {
        "tsLint.serverUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Server URL for the TS-Lint service"
        },
        "tsLint.secret": {
          "type": "string",
          "default": "ChangeMeInProduction",
          "description": "Secret token for secure connection"
        },
        "tsLint.forceWebsocket": {
          "type": "boolean",
          "default": false,
          "description": "Force WebSocket transport (recommended for Cloudflare Tunnels)"
        },
        "tsLint.autoReveal": {
          "type": "boolean",
          "default": false,
          "description": "Automatically reveal output channel and mark as read when new message arrives"
        },
        "tsLint.displayMode": {
          "type": "string",
          "enum": [
            "bubble",
            "log"
          ],
          "default": "bubble",
          "description": "Output format for service messages (bubble: standard, log: compact log format)"
        },
        "tsLint.connections": {
          "type": "array",
          "default": [],
          "description": "Connection configurations",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Connection name"
              },
              "serverUrl": {
                "type": "string",
                "description": "Server URL"
              },
              "token": {
                "type": "string",
                "description": "Authentication token"
              }
            },
            "required": [
              "name",
              "token"
            ]
          }
        },
        "tsLint.activeConnection": {
          "type": "string",
          "default": "",
          "description": "Active connection name"
        }
      }
    },
    "keybindings": [
      {
        "command": "extension.stealthSend",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "socket.io-client": "^4.7.0"
  }
}
