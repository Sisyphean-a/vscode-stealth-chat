{
  "name": "stealth-chat-client",
  "displayName": "Stealth Chat Client",
  "description": "A lightweight VS Code client for Stealth Chat.",
  "version": "1.0.2",
  "publisher": "xixifu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sisyphean-a/vscode-stealth-chat.git"
  },
  "homepage": "https://github.com/Sisyphean-a/vscode-stealth-chat/tree/master/extension",
  "bugs": {
    "url": "https://github.com/Sisyphean-a/vscode-stealth-chat/issues"
  },
  "qna": false,
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "stealth chat",
    "chat client",
    "messages",
    "socket.io",
    "companion"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#E9E1D3",
    "theme": "light"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tsLintService",
          "title": "Bridge",
          "icon": "$(check)"
        }
      ]
    },
    "views": {
      "tsLintService": [
        {
          "type": "webview",
          "id": "tsLintChat.chatView",
          "name": "Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.stealthSend",
        "title": "Send Message",
        "category": "Stealth Chat"
      },
      {
        "command": "tsLintService.focus",
        "title": "Focus Stealth Chat",
        "category": "Stealth Chat"
      },
      {
        "command": "tsLintService.switchConnection",
        "title": "Switch Connection",
        "category": "Stealth Chat"
      }
    ],
    "configuration": {
      "title": "Stealth Chat Client",
      "properties": {
        "stealthChat.serverUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Default Stealth Chat server URL"
        },
        "stealthChat.secret": {
          "type": "string",
          "default": "ChangeMeInProduction",
          "description": "Fallback token for the default connection"
        },
        "stealthChat.forceWebsocket": {
          "type": "boolean",
          "default": false,
          "description": "Force WebSocket transport"
        },
        "stealthChat.autoReveal": {
          "type": "boolean",
          "default": false,
          "description": "Reveal the output channel when new messages arrive"
        },
        "stealthChat.displayMode": {
          "type": "string",
          "enum": [
            "bubble",
            "log"
          ],
          "default": "bubble",
          "description": "Message display mode"
        },
        "stealthChat.connections": {
          "type": "array",
          "default": [],
          "description": "Saved Stealth Chat connections",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Connection name"
              },
              "serverUrl": {
                "type": "string",
                "description": "Optional server URL override"
              },
              "token": {
                "type": "string",
                "description": "Authentication token"
              },
              "backgroundSync": {
                "type": "boolean",
                "description": "Include this connection in background sync"
              }
            },
            "required": [
              "name",
              "token"
            ]
          }
        },
        "stealthChat.activeConnection": {
          "type": "string",
          "default": "",
          "description": "Active connection name"
        },
        "stealthChat.backgroundSyncEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable background sync"
        },
        "stealthChat.backgroundSyncIntervalMs": {
          "type": "number",
          "default": 4000,
          "minimum": 1000,
          "maximum": 10000,
          "description": "Background sync polling interval in milliseconds"
        }
      }
    },
    "keybindings": [
      {
        "command": "extension.stealthSend",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "vsix:package": "vsce package --no-dependencies",
    "vsix:list": "vsce ls --tree --no-dependencies",
    "protocol:generate": "node ../packages/protocol/scripts/generate-protocol.js",
    "protocol:test": "node ../packages/protocol/scripts/protocol-boundary-smoke.js",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "npm run protocol:generate && tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "npm run protocol:generate && npm run protocol:test && tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.27.3",
    "esbuild-svelte": "^0.9.3",
    "npm-run-all": "^4.1.5",
    "svelte": "^4.2.20",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "socket.io-client": "^4.7.0"
  }
}
