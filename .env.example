# Gotify 管理员密码
GOTIFY_PASS=admin

# 默认应用的 Config (为了兼容旧版)
GOTIFY_TOKEN=ExistingGotifyToken
STEALTH_SECRET=ChangeMeInProduction

# 数据库配置
MESSAGE_RETENTION_DAYS=30
MESSAGE_MAX_COUNT=1000

# 点击通知跳转的地址
CLICK_URL=https://chat.sisyphean.top

# [NEW] 多应用/多Token配置
# 如果设置了此项，上面的 STEALTH_SECRET 将只作为默认应用的 fallback
# 格式: JSON 字符串
# APP_APPS='[{"id":"default","name":"默认组","token":"ChangeMeInProduction","gotifyToken":"Token1"},{"id":"vip","name":"VIP组","token":"SecretVIP","gotifyToken":"Token2"}]'
APP_APPS=